# ============================================================
# 开发环境配置文件
# ============================================================

# ==================== 基础服务配置 ====================
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=debug

# ==================== 数据库配置 ====================
DB_DSN=postgres://postgres:password@timescaledb:5432/quant_trader?sslmode=disable

# ==================== 消息队列配置 ====================
NATS_URL=nats://nats:4222

# ==================== 缓存配置 ====================
REDIS_URL=redis://redis:6379

# ==================== 撮合引擎配置 ====================
MATCHING_ENABLED=true
MATCHING_LEASE_TTL=20s
MATCHING_LEASE_REFRESH=5s
MATCHING_SNAPSHOT_EVERY=2s
MATCHING_OWNER=dev-local

# ==================== 交易所配置 ====================
EXCHANGE_URL=wss://stream.binance.com:9443/ws

# ==================== 监控配置 ====================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================== 支付配置 (测试环境) ====================
STRIPE_API_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== 安全配置 ====================
JWT_SECRET=dev-jwt-secret-key-change-in-production

# ==================== 告警通知配置 ====================
# 开发环境可选，留空即可
DINGTALK_WEBHOOK=
WECHAT_WEBHOOK=

# ==================== AI 配置 (可选) ====================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
