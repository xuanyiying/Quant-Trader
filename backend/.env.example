# 量化交易平台配置模板
# 复制此文件为 .env 并填入实际值

# ============================================
# 基础服务配置
# ============================================

# HTTP 服务端口
PORT=8080

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# 数据库配置 (必需)
# ============================================

# PostgreSQL 数据库连接字符串
DB_DSN=postgres://postgres:password@localhost:5432/quant_trader

# ============================================
# 消息队列配置
# ============================================

# NATS 服务器地址
NATS_URL=nats://localhost:4222

# ============================================
# 撮合引擎配置
# ============================================

# 是否启用撮合引擎
MATCHING_ENABLED=true

# 租约 TTL (多久不续约视为失联)
MATCHING_LEASE_TTL=20s

# 租约刷新间隔
MATCHING_LEASE_REFRESH=5s

# 快照保存间隔
MATCHING_SNAPSHOT_EVERY=2s

# 当前实例标识 (hostname 或 pod name)
MATCHING_OWNER=

# ============================================
# 交易所配置
# ============================================

# 交易所 WebSocket URL
EXCHANGE_URL=wss://stream.binance.com:9443/ws

# ============================================
# 监控配置
# ============================================

# 是否启用 Prometheus 指标
ENABLE_METRICS=true

# Prometheus 指标端口
METRICS_PORT=9090

# ============================================
# 支付配置 (Stripe)
# ============================================

# Stripe API 密钥 (测试环境使用 sk_test_xxx, 生产环境使用 sk_live_xxx)
STRIPE_API_KEY=sk_test_your_stripe_key_here

# Stripe Webhook 密钥
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# 安全配置
# ============================================

# JWT 签名密钥 (生产环境请使用强随机字符串)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# 告警通知配置 (可选)
# ============================================

# 钉钉机器人 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 企业微信机器人 Webhook
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# SMTP 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Quant Trader <alerts@quant-trader.com>

# ============================================
# AI 配置 (可选)
# ============================================

# OpenAI API 密钥
OPENAI_API_KEY=sk-your-openai-api-key

# Claude API 密钥
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
