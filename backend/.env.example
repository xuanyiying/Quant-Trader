# ============================================================
# Quant Trader Backend Configuration
# ============================================================

# ------------------- 基础配置 -------------------
PORT=8080
LOG_LEVEL=info

# ------------------- 数据库配置 -------------------
DB_DSN=postgres://postgres:password@localhost:5432/quant_trader?sslmode=disable

# ------------------- 消息队列配置 -------------------
NATS_URL=nats://localhost:4222

# ------------------- 代理配置 (可选) -------------------
# 如果在中国大陆或其他受限地区，需要配置代理才能连接交易所 API
# 支持以下三种格式:
# 1. HTTP/HTTPS 代理: http://proxy-host:port
# 2. SOCKS5 代理: socks5://proxy-host:port
# 3. 简写格式 (默认使用 SOCKS5): proxy-host:port

# 方式 1: 使用环境变量 (推荐)
HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# SOCKS5_PROXY=socks5://127.0.0.1:7891

# 方式 2: 在终端中设置 (二选一)
# export HTTPS_PROXY=http://127.0.0.1:7890
# export ALL_PROXY=socks5://127.0.0.1:7891

# ------------------- 监控配置 -------------------
ENABLE_METRICS=true
METRICS_PORT=9090

# ------------------- 撮合引擎配置 -------------------
MATCHING_ENABLED=true
MATCHING_LEASE_TTL=20s
MATCHING_LEASE_REFRESH=5s
MATCHING_SNAPSHOT_EVERY=2s
MATCHING_OWNER=

# ------------------- 支付配置 -------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------- 认证配置 -------------------
JWT_SECRET=your-secret-key-change-in-production
